# ============================================
# 太初寰宇 后端 —— 环境变量模板（secrets）
# 复制本文件为 .env，或直接设置为系统/进程环境变量。
# ASP.NET Core 会自动读取环境变量并覆盖 appsettings.json（无需改代码）。
# 命名规则：配置层级用双下划线 __ 分隔，例如 Jwt:Key → Jwt__Key
# ============================================

# 数据库连接串（含 user / password）
ConnectionStrings__DefaultConnection=

# 邮箱 1（太初灵枢）QQ 邮箱授权码
EmailConfig__Password=

# 邮箱 2（太初寰宇社区）QQ 邮箱授权码
EmailConfig2__Password=

# JWT 签名密钥（任意长字符串）
Jwt__Key=

# 腾讯云 COS 密钥
TencentCloud__SecretId=
TencentCloud__SecretKey=

# Minio 存储
MinioSettings__AccessKey=
MinioSettings__SecretKey=

# BYOK AI 功能：AES 加密密钥（任意 32 字节以上字符串）
Ai__EncryptionKey=
