<Window x:Class="TaiChuHuanYu_DeskTop_V1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaiChuHuanYu_DeskTop_V1"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="太初寰宇桌面平台" Height="1080" Width="1920">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 美化工具栏 -->
        <Border Grid.Row="0" Background="#34495E" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ToggleModeBtn" 
                    Content="📂 切换到本地模式" 
                    Click="ToggleMode_Click"
                    Width="200" Height="34"
                    Background="#1ABC9C" 
                    Foreground="White"
                    FontWeight="SemiBold"
                    FontSize="14"
                    BorderThickness="0"
                    Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <TextBlock x:Name="ModeStatus" 
                       Text="当前：远程模式" 
                       VerticalAlignment="Center" 
                       Margin="25,0,0,0"
                       Foreground="#ECF0F1"
                       FontSize="15"
                       FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- WebView2 -->
        <wv2:WebView2 x:Name="MainWebView" Grid.Row="1"/>
    </Grid>
</Window>